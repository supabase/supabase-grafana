// Grafana Alloy configuration for Supabase metrics collection.
// Alloy is the open-source successor to Grafana Agent (EOL: November 2025).
//
// Pipeline:
//   prometheus.scrape "supabase" --> prometheus.remote_write "local"
//
// Required environment variables:
//   SUPABASE_PROJECT_REF  - your Supabase project ref (e.g. abcdefghijklmnop)
//   SUPABASE_API_KEY      - Secret API key from Project Settings > API Keys (sb_secret_...)

prometheus.scrape "supabase" {
  targets = [{
    __address__ = sys.env("SUPABASE_PROJECT_REF") + ".supabase.co:443",
  }]

  scheme          = "https"
  metrics_path    = "/customer/v1/privileged/metrics"
  scrape_interval = "60s"

  basic_auth {
    username = "username"
    password = sys.env("SUPABASE_API_KEY")
  }

    forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}